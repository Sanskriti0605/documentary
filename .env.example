# Server Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8001
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./storage/db/veritas.db
SYNC_DATABASE_URL=sqlite:///./storage/db/veritas.db

# Qdrant Vector DB
QDRANT_URL=
QDRANT_STORAGE_PATH=./storage/qdrant
QDRANT_COLLECTION=veritas_clauses

# Storage Paths
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
RENDERED_DIR=./storage/rendered

# LLM Generation Provider
# Primary Provider: openrouter (NVIDIA Nemotron 3.5 Lightning Free)
# Alternative Provider: ollama (local offline)
LLM_PROVIDER=openrouter
AI_PROVIDER=openrouter

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://veritas.ai
OPENROUTER_TITLE=VERITAS AI
OPENROUTER_TIMEOUT_SECONDS=45.0
OPENROUTER_MAX_RETRIES=3

# Local Ollama Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embeddings & NLI Models (Preserved Local HuggingFace Pipeline)
EMBEDDING_MODEL=BAAI/bge-m3
NLI_MODEL=cross-encoder/nli-deberta-v3-small
