# Server Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8001
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database
# Use PostgreSQL in production/docker: postgresql+psycopg://veritas:veritas@localhost:5432/veritas_db
# Or SQLite fallback for instant zero-dependency local execution: sqlite+aiosqlite:///./storage/db/veritas.db
DATABASE_URL=sqlite+aiosqlite:///./storage/db/veritas.db
SYNC_DATABASE_URL=sqlite:///./storage/db/veritas.db

# Qdrant Vector DB
# Set QDRANT_URL to use remote instance, or leave empty/set QDRANT_STORAGE_PATH for local embedded vector storage
QDRANT_URL=
QDRANT_STORAGE_PATH=./storage/qdrant

# Storage
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
RENDERED_DIR=./storage/rendered

# AI Model Provider
# Options: local, ollama, colab, mock
AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
COLAB_WORKER_URL=
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
GENERATION_MODEL=Qwen3-4B-Instruct-2507
NLI_MODEL=mDeBERTa-v3-base-mnli-xnli
